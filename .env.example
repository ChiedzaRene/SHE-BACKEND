DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Only used by backup.py
SUPABASE_URL=
# Set to true locally to expose /docs and /redoc (off by default)
ENABLE_DOCS=false
# Token lifetime in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Extra comma-separated CORS origins, e.g. a LAN address for testing on a phone
EXTRA_CORS_ORIGINS=
# Optional error monitoring (requires: pip install sentry-sdk)
SENTRY_DSN=

# Audit-log entries older than this many days are deleted automatically (default 730 = 2 years, minimum 30)
# AUDIT_RETENTION_DAYS=730
